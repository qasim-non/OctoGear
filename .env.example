APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Chat uses the named Reverb connection independently of other events.
CHAT_REALTIME_ENABLED=false
CHAT_WEBSOCKET_URL=ws://127.0.0.1:8080
CHAT_REALTIME_QUEUE_CONNECTION=database
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Native mobile clients omit Origin; private channel authorization is mandatory.
REVERB_ALLOWED_ORIGINS=*
FILESYSTEM_DISK=local
IMAGE_DISK=images_local
IMAGE_MAX_FILES=5
IMAGE_MAX_FILE_SIZE_KB=5120
# Optional override for customer-car uploads; existing rows retain their disk.
# CUSTOMER_CAR_MEDIA_DISK=customer_car_media_local
CUSTOMER_CAR_IDEMPOTENCY_RETENTION_HOURS=24
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional OTP display for local development/staging; never exposed in production.
OTP_EXPOSE_FOR_TESTING=false

# Android customer push. Keep disabled until credentials and a queue worker are ready.
FCM_ENABLED=true
FCM_PROJECT_ID=octogear-1d72b
FCM_CREDENTIALS=
FCM_QUEUE_CONNECTION=database
